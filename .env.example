# Buffer Configuration
UPLINK_BUF_FRAMES=100
DOWNLINK_BUF_FRAMES=200

# AI Vendor Configuration
# Options: openai, deepgram, gemini, grok
AI_VENDOR=openai

# Agent Prompt File (REQUIRED for Deepgram, OpenAI)
# YAML file containing greeting and instructions
AGENT_PROMPT_FILE=agent_prompt.yaml

# OpenAI Configuration (when AI_VENDOR=openai)
OPENAI_API_KEY=your_openai_api_key_here
# Optional. If set, it must match the project that owns OPENAI_API_KEY.
OPENAI_WS_ENDPOINT=wss://api.openai.com/v1/realtime
OPENAI_PROJECT=your_openai_project_id_here
OPENAI_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin  # Leave empty to use the server's default voice
# Audio format on the Realtime WebSocket:
#   pcmu  -> G.711 μ-law @ 8kHz passthrough (default, OpenAI)
#   pcm16 -> PCM16 @ 24kHz with 8kHz <-> 24kHz resampling (Realtime-compatible gateways
#            that reject audio/pcmu, e.g. cascade-realtime-gateway)
OPENAI_AUDIO_FORMAT=pcmu
# Input noise reduction: near_field (default), far_field, none (none is required by cascade)
OPENAI_NOISE_REDUCTION=near_field
# cascade-realtime-gateway example:
#   OPENAI_WS_ENDPOINT=ws://127.0.0.1:18080/v1/realtime
#   OPENAI_API_KEY=sk-test  # the gateway's REALTIME_API_KEY
#   OPENAI_MODEL=qwen       # echoed only; not used for routing
#   OPENAI_AUDIO_FORMAT=pcm16
#   OPENAI_NOISE_REDUCTION=none
#   OPENAI_VOICE=           # empty: use the gateway profile's voice

# Deepgram Configuration (when AI_VENDOR=deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_LISTEN_MODEL=flux-general-en  # STT model: flux-general-en (Flux, v2) or legacy nova-2/nova-3 (v1)
DEEPGRAM_SPEAK_MODEL=flux-kit-en  # TTS voice: flux-kit-en (Flux, v2) or legacy aura-asteria-en (v1); only used when SPEAK_PROVIDER=deepgram
DEEPGRAM_LLM_MODEL=gpt-4o-mini  # LLM for agent: gpt-4o-mini (default), gpt-4o, gpt-5-mini (measured 1.5-6.6 s slower per turn on real calls)
# Barge-in (Flux listen models only): caller may interrupt the agent. Lines without echo
# cancellation (e.g. speakerphone softphones) make the agent hear itself and interrupt
# itself; set DEEPGRAM_BARGE_IN=false there (half-duplex). Accepts true/false/1/0/yes/no.
DEEPGRAM_BARGE_IN=true
# Optional Flux tuning (only sent when set): turn detection (Flux listen models) and TTS speed
# DEEPGRAM_EOT_THRESHOLD=0.7         # 0.5-1.0
# DEEPGRAM_EAGER_EOT_THRESHOLD=0.5   # 0.3-0.9, must not exceed EOT threshold
# DEEPGRAM_EOT_TIMEOUT_MS=5000
# DEEPGRAM_SPEAK_SPEED=1.0           # Flux 0.5-1.5, Aura 0.7-1.5

# Speak provider: who renders the Deepgram agent's voice.
#   deepgram -> built-in Deepgram TTS (default: Flux flux-kit-en)
#   60db     -> Deepgram stays the brain (STT + LLM + turn-taking), 60db is the voice
SPEAK_PROVIDER=deepgram
# 60db voice (required when SPEAK_PROVIDER=60db). List voices: uv run python scripts/list_60db_voices.py
SIXTYDB_API_KEY=your_60db_api_key_here
SIXTYDB_VOICE_ID=fbb75ed2-975a-40c7-9e06-38e30524a9a1  # 60db default voice

# Gemini Live Configuration (when AI_VENDOR=gemini)
# Get API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-live  # Any Live API model (legacy previews: gemini-3.1-flash-live-preview, gemini-2.5-flash-native-audio-preview-12-2025)
GEMINI_VOICE=Puck  # Voice: Puck, Charon, Kore, Fenrir, Aoede

# xAI Grok Voice Configuration (when AI_VENDOR=grok)
# Get API key from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-voice-think-fast-2.0  # Options: grok-voice-latest, grok-voice-think-fast-2.0
GROK_VOICE=eve  # Built-in voices: eve (default), ara, leo, rex, sal
GROK_WS_ENDPOINT=wss://api.x.ai/v1/realtime

# SIP Configuration (Userless Account - Receive Only)
# No registration required, only listens for incoming SIP INVITE requests
# Typically used in internal network, TLS not required
SIP_DOMAIN=localhost  # SIP domain or IP address (useful for multi-IP servers)
SIP_TRANSPORT_TYPE=udp
SIP_PORT=6060

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Connection Management
HEALTH_CHECK_INTERVAL_SEC=30
RECONNECT_DELAY_SEC=5
MAX_RECONNECT_ATTEMPTS=3
